{
  "name": "almac-browser",
  "version": "1.3.7",
  "description": "Almac Browser — a pixel-aesthetic, privacy-focused browser built on Electron + Chromium with built-in ad blocker, Chrome extension support, DNS-over-HTTPS, multi-profile, and workspaces.",
  "main": "main.js",
  "productName": "Almac Browser",
  "author": {
    "name": "Alianama",
    "url": "https://github.com/Alianama"
  },
  "homepage": "https://github.com/Alianama/almac-browser",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alianama/almac-browser.git"
  },
  "bugs": {
    "url": "https://github.com/Alianama/almac-browser/issues"
  },
  "keywords": [
    "browser",
    "electron",
    "chromium",
    "pixel",
    "privacy",
    "ad-blocker",
    "chrome-extensions",
    "dns-over-https",
    "multi-profile",
    "workspaces",
    "glassmorphism",
    "macos"
  ],
  "license": "GPL-3.0",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/dev-brand.js",
    "build-icons": "node scripts/build-icons.js",
    "build-logo": "node scripts/build-logo.js",
    "dist": "electron-builder --mac --publish never",
    "test": "node passwords.test.js && node updater.test.js && node lookalike.test.js",
    "release": "node scripts/release.js",
    "dist:win": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "@fontsource/silkscreen": "^5.3.0",
    "@ghostery/adblocker-electron": "^2.20.1",
    "electron-chrome-extensions": "^4.9.0",
    "electron-chrome-web-store": "^0.13.0",
    "tldts-experimental": "^7.4.18"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.alianama.almac-browser",
    "productName": "Almac Browser",
    "files": [
      "main.js",
      "updater.js",
      "passwords.js",
      "lookalike.js",
      "preload.js",
      "media-preload.js",
      "music-preload.js",
      "password-preload.js",
      "pet-preload.js",
      "spotlight-preload.js",
      "ui/**",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "artifactName": "Almac-Browser-${version}-${arch}.${ext}",
      "extendInfo": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Web site URL",
            "CFBundleURLSchemes": [
              "http",
              "https"
            ]
          }
        ],
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "HTML document",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "public.html",
              "public.xhtml"
            ]
          }
        ]
      }
    },
    "electronFuses": {
      "enableCookieEncryption": true,
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Almac-Browser-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Almac Browser",
      "uninstallDisplayName": "Almac Browser"
    }
  }
}
